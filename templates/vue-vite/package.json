{
  "name": "simple-frontend-vue-vite-template",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "build": "vue-tsc --noEmit && vite build",
    "check": "npm run type-check && npm run lint && npm run test:coverage && npm run build && npm run test:browser"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "2.1.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "9.32.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.21",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
  }
}
